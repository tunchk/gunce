generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PARENT
  CHILD
}

enum AgeGroup {
  AGE_9_11
  AGE_12_14
}

enum ParentOnboardingStep {
  CHILD_PROFILE
  EXPLANATION
  PAIRING
  COMPLETE
}

enum ChildOnboardingStep {
  AVATAR
  EXPLANATION
  COMPLETE
}

enum JournalPrompt {
  LIKED
  HARD
  LEARNED
  TODO
  FREE
}

enum JournalEntryStatus {
  DRAFT
  SAVED
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  DISCARDED
  STALE
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          UserRole  @default(PARENT)

  sessions Session[]
  accounts Account[]

  memberships         FamilyMembership[]
  createdInvitations  PairingInvitation[] @relation("InvitationCreator")
  childProfile        ChildProfile?
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Family {
  id             String              @id @default(cuid())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  onboardingStep ParentOnboardingStep @default(CHILD_PROFILE)

  members  FamilyMembership[]
  children ChildProfile[]
}

model FamilyMembership {
  id        String   @id @default(cuid())
  familyId  String
  userId    String
  createdAt DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@unique([userId])
  @@index([familyId])
}

model ChildProfile {
  id               String              @id @default(cuid())
  familyId         String
  displayName      String
  ageGroup         AgeGroup
  timeZone         String
  avatarKey        String?
  onboardingStep   ChildOnboardingStep @default(AVATAR)
  userId           String?             @unique
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  family      Family              @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  invitations PairingInvitation[]
  journalEntries JournalEntry[]
  publishedShares PublishedShare[]
  planCommitments PlanCommitment[]
  planStudySteps PlanStudyStep[]
  planGoals PlanGoal[]
  planExtractBatches PlanExtractBatch[]
  reminderPreferences ChildReminderPreferences?
  pushSubscriptions ChildPushSubscription[]
  reminderOccurrences ReminderOccurrence[]
  reminderDayBuckets ReminderDayBucket[]

  @@index([familyId])
}

model PairingInvitation {
  id              String    @id @default(cuid())
  childId         String
  createdByUserId String
  tokenHash       String    @unique
  expiresAt       DateTime
  redeemedAt      DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  child     ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
  createdBy User         @relation("InvitationCreator", fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@index([expiresAt])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Private writing owned exclusively by the child. Never returned by parent APIs.
model JournalEntry {
  id              String             @id @default(cuid())
  childId         String
  promptKey       JournalPrompt?
  /// Calendar date in the child's configured time zone (UTC midnight of that date).
  diaryDate       DateTime           @db.Date
  /// Current working text (typed, reviewed transcript, or accepted summary).
  body            String             @default("")
  /// Preserved child-authored / reviewed text before accepting a summary.
  originalBody    String             @default("")
  /// Last accepted AI summary text (private). Empty if none accepted.
  acceptedSummary String             @default("")
  status          JournalEntryStatus @default(DRAFT)
  revision        Int                @default(1)
  /// Optional client key so create retries do not insert duplicates.
  clientRequestId String?            @unique
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  child       ChildProfile        @relation(fields: [childId], references: [id], onDelete: Cascade)
  draft       SharingDraft?
  published   PublishedShare?
  transcripts JournalTranscript[]
  suggestions JournalSuggestion[]
  planExtractBatches PlanExtractBatch[]

  @@index([childId, diaryDate])
  @@index([childId, updatedAt])
}

/// Text-only transcript of a voice capture. Audio is never stored.
model JournalTranscript {
  id             String   @id @default(cuid())
  entryId        String
  text           String
  /// Entry revision at the time the transcript was applied to the body (0 if pending review).
  sourceRevision Int      @default(0)
  /// Client-stable id so retries do not create duplicate segment rows.
  segmentId      String?  @unique
  /// 1-based order within a recording session.
  sequence       Int      @default(1)
  /// Groups segments from one multi-part recording session.
  sessionId      String?
  createdAt      DateTime @default(now())

  entry JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, createdAt])
  @@index([entryId, sessionId, sequence])
}

/// AI summary suggestion tied to a specific source revision of the working text.
model JournalSuggestion {
  id             String           @id @default(cuid())
  entryId        String
  /// Opaque request id so late responses after delete are discarded.
  requestId      String           @unique
  suggestedText  String
  sourceRevision Int
  status         SuggestionStatus @default(PENDING)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  entry JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, createdAt])
}

/// Editable parent-facing draft, independent of private journal body.
model SharingDraft {
  id             String   @id @default(cuid())
  entryId        String   @unique
  parentMessage  String   @default("")
  supportRequest String   @default("")
  revision       Int      @default(1)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  entry JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

/// Snapshot approved by the child for parent visibility. Soft-withdrawn via withdrawnAt.
model PublishedShare {
  id                  String    @id @default(cuid())
  entryId             String    @unique
  childId             String
  familyId            String
  parentMessage       String    @default("")
  supportRequest      String    @default("")
  sourceDraftRevision Int
  publishedAt         DateTime  @default(now())
  withdrawnAt         DateTime?

  entry    JournalEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  child    ChildProfile    @relation(fields: [childId], references: [id], onDelete: Cascade)
  guidance ParentGuidance?

  @@index([familyId, withdrawnAt, publishedAt])
  @@index([childId, withdrawnAt])
}

/// Cached AI approach tips for a parent, tied to one published snapshot revision.
/// Built only from published parentMessage / supportRequest — never private journal text.
model ParentGuidance {
  id                   String   @id @default(cuid())
  shareId              String   @unique
  /// Matches PublishedShare.sourceDraftRevision at generation time.
  snapshotRevision     Int
  conversationOpener   String
  supportAction        String
  provider             String   @default("")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  share PublishedShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
}

enum PlanCommitmentType {
  HOMEWORK
  EXAM
  COURSE
}

/// Workflow status for study/preparation steps (board + week views share this).
enum PlanStudyStepStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum PlanGoalStatus {
  ACTIVE
  ACHIEVED
  ARCHIVED
}

/// Child-reviewed plan suggestions extracted from one journal revision (private).
enum PlanExtractBatchStatus {
  READY
  STALE
  APPLIED
}

enum PlanExtractCandidateType {
  HOMEWORK
  EXAM
  COURSE
  STUDY_STEP
}

enum PlanExtractMentionKind {
  EXPLICIT
  PREPARATION
}

enum PlanExtractCandidateStatus {
  PENDING
  APPLIED
  SKIPPED
}

/// Child-owned longer-term learning goal. Progress comes from linked PlanStudyStep rows.
model PlanGoal {
  id              String         @id @default(cuid())
  childId         String
  title           String
  /// Optional intended outcome description.
  description     String         @default("")
  /// Optional target calendar date (intention, not an automatic deadline).
  targetDate      DateTime?      @db.Date
  status          PlanGoalStatus @default(ACTIVE)
  revision        Int            @default(1)
  clientRequestId String?        @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  child      ChildProfile    @relation(fields: [childId], references: [id], onDelete: Cascade)
  studySteps PlanStudyStep[]

  @@index([childId, status])
  @@index([childId, targetDate])
}

/// Homework, exam, or course commitment owned by the child.
/// Dates are calendar dates (Date-only), not wall-clock UTC timestamps.
model PlanCommitment {
  id              String             @id @default(cuid())
  childId         String
  type            PlanCommitmentType
  title           String
  subject         String             @default("")
  /// Homework due date; null means “tarih belli değil”.
  dueDate         DateTime?          @db.Date
  /// Exam/course event date (required for EXAM and COURSE).
  eventDate       DateTime?          @db.Date
  /// Optional local wall time in the child's time zone, stored as "HH:mm".
  eventTimeLocal  String?
  completedAt     DateTime?
  revision        Int                @default(1)
  clientRequestId String?            @unique
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  child      ChildProfile    @relation(fields: [childId], references: [id], onDelete: Cascade)
  studySteps PlanStudyStep[]

  @@index([childId, eventDate])
  @@index([childId, dueDate])
  @@index([childId, completedAt])
}

/// Preparation / study step. May link to homework or exam, or stand alone.
model PlanStudyStep {
  id                   String              @id @default(cuid())
  childId              String
  title                String
  subject              String              @default("")
  /// Planned calendar date; null = unscheduled.
  plannedDate          DateTime?           @db.Date
  estimatedMinutes     Int?
  relatedCommitmentId  String?
  /// Optional link to at most one child-owned goal (same child).
  relatedGoalId        String?
  /// Optional reminder wall time in the child's time zone ("HH:mm"). Null = no step reminder.
  reminderLocalTime    String?
  /// Authoritative workflow state. Do not infer status from completedAt.
  status               PlanStudyStepStatus @default(TODO)
  /// Metadata only: set when entering DONE, cleared when leaving DONE. Not a second source of truth.
  completedAt          DateTime?
  revision             Int                 @default(1)
  clientRequestId      String?             @unique
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  child             ChildProfile    @relation(fields: [childId], references: [id], onDelete: Cascade)
  relatedCommitment PlanCommitment? @relation(fields: [relatedCommitmentId], references: [id], onDelete: SetNull)
  relatedGoal       PlanGoal?       @relation(fields: [relatedGoalId], references: [id], onDelete: SetNull)
  reminderOccurrences ReminderOccurrence[]

  @@index([childId, plannedDate])
  @@index([childId, status])
  @@index([relatedCommitmentId])
  @@index([relatedGoalId])
}

enum ReminderKind {
  JOURNAL
  STUDY_STEP
}

enum ReminderOccurrenceStatus {
  PENDING
  CLAIMED
  SENT
  SKIPPED
  CANCELLED
  FAILED
  EXPIRED
}

/// Per-child reminder preferences (off by default).
model ChildReminderPreferences {
  id                      String   @id @default(cuid())
  childId                 String   @unique
  journalReminderEnabled  Boolean  @default(false)
  /// Local wall time HH:mm for the daily journal invitation.
  journalReminderLocalTime String  @default("19:00")
  studyRemindersEnabled   Boolean  @default(false)
  quietHoursStart         String   @default("21:00")
  quietHoursEnd           String   @default("08:00")
  revision                Int      @default(1)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)
}

/// Web Push subscription bound to one child and optionally one Better Auth session.
model ChildPushSubscription {
  id           String    @id @default(cuid())
  childId      String
  userId       String
  /// Better Auth session id when registered; cleared/revoked with that session.
  sessionId    String?
  endpoint     String    @unique
  p256dh       String
  auth         String
  userAgent    String    @default("")
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  child      ChildProfile         @relation(fields: [childId], references: [id], onDelete: Cascade)
  deliveries ReminderDelivery[]

  @@index([childId, revokedAt])
  @@index([userId])
  @@index([sessionId])
}

/// Durable scheduled reminder occurrence (outbox).
model ReminderOccurrence {
  id               String                   @id @default(cuid())
  /// Stable key for idempotent materialization (journal:child:date or step:id:date:time).
  occurrenceKey    String                   @unique
  childId          String
  kind             ReminderKind
  studyStepId      String?
  /// UTC instant when delivery may begin (after quiet-hours deferral).
  scheduledAt      DateTime
  /// Child-local calendar day used for daily caps.
  effectiveLocalDate DateTime               @db.Date
  status           ReminderOccurrenceStatus @default(PENDING)
  claimToken       String?
  claimedAt        DateTime?
  claimExpiresAt   DateTime?
  attemptCount     Int                      @default(0)
  lastError        String                   @default("")
  /// Bumped when prefs/step schedule change; stale claims must not send.
  scheduleRevision Int                      @default(1)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  child      ChildProfile         @relation(fields: [childId], references: [id], onDelete: Cascade)
  studyStep  PlanStudyStep?       @relation(fields: [studyStepId], references: [id], onDelete: Cascade)
  deliveries ReminderDelivery[]

  @@index([status, scheduledAt])
  @@index([childId, effectiveLocalDate])
  @@index([studyStepId])
  @@index([claimExpiresAt])
}

model ReminderDelivery {
  id             String   @id @default(cuid())
  occurrenceId   String
  subscriptionId String
  /// accepted = push service accepted; not proof of display.
  acceptedAt     DateTime?
  failedAt       DateTime?
  errorCode      String   @default("")
  createdAt      DateTime @default(now())

  occurrence   ReminderOccurrence    @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  subscription ChildPushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([occurrenceId, subscriptionId])
  @@index([subscriptionId])
}

/// Daily sent-count bucket for the per-child local-day reminder cap (concurrency-safe).
model ReminderDayBucket {
  id        String   @id @default(cuid())
  childId   String
  localDate DateTime @db.Date
  sentCount Int      @default(0)
  updatedAt DateTime @updatedAt

  child ChildProfile @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, localDate])
}

/// Private AI plan-suggestion batch for one journal entry revision. Never exposed to parents.
model PlanExtractBatch {
  id             String                 @id @default(cuid())
  entryId        String
  childId        String
  /// Opaque request id so late responses / retries stay idempotent.
  requestId      String                 @unique
  sourceRevision Int
  diaryDate      DateTime               @db.Date
  status         PlanExtractBatchStatus @default(READY)
  provider       String                 @default("")
  /// Idempotent apply key for the whole confirmation request.
  applyRequestId String?                @unique
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  entry      JournalEntry            @relation(fields: [entryId], references: [id], onDelete: Cascade)
  child      ChildProfile            @relation(fields: [childId], references: [id], onDelete: Cascade)
  candidates PlanExtractCandidate[]

  @@index([entryId, createdAt])
  @@index([childId, createdAt])
}

model PlanExtractCandidate {
  id                      String                     @id @default(cuid())
  batchId                 String
  /// Stable order within the batch (0-based); prep steps may reference another ordinal.
  ordinal                 Int
  type                    PlanExtractCandidateType
  mentionKind             PlanExtractMentionKind
  title                   String
  subject                 String                     @default("")
  sourceExcerpt           String
  /// Original date wording from the journal (may be empty).
  datePhrase              String                     @default("")
  /// Server-proposed calendar date from diary date + phrase (nullable).
  proposedDate            DateTime?                  @db.Date
  dateUncertain           Boolean                    @default(false)
  estimatedMinutes        Int?
  relatedCandidateOrdinal Int?
  status                  PlanExtractCandidateStatus @default(PENDING)
  appliedCommitmentId     String?
  appliedStudyStepId      String?
  /// Per-candidate plan create idempotency key.
  applyClientRequestId    String?                    @unique
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  batch PlanExtractBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, ordinal])
  @@index([batchId])
}
