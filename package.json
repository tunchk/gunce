{
  "name": "gunce",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n app,jobs -c blue,magenta \"next dev\" \"npm run jobs:worker\"",
    "dev:app": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "reminders:process": "npx tsx scripts/process-reminders.ts",
    "jobs:process": "npx tsx scripts/process-jobs.ts",
    "jobs:worker": "npx tsx scripts/jobs-worker.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.16.1",
    "better-auth": "^1.3.8",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "web-push": "^3.6.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/web-push": "^3.6.4",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.2",
    "prisma": "^6.16.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
