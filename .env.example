# Database
DATABASE_URL="postgresql://gunce:gunce@localhost:5432/gunce?schema=public"

# Better Auth — generate a long random secret for local use
# Example: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
# Absolute app origin used for auth cookies and email links (do not rely on Host headers)
BETTER_AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Milestone 3 / 6: OpenAI (optional) ---
# Without OPENAI_API_KEY, journaling and manual planning still work; voice,
# “Yazımı toparla”, and journal→plan suggestions are marked unavailable.
# OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# OPENAI_SUMMARY_MODEL=gpt-4o-mini
# OPENAI_PLAN_EXTRACT_MODEL=gpt-4o-mini

# Automated tests / Playwright only — enables deterministic AI stubs (never for normal use).
# Under NODE_ENV=production, stubs also require GUNCE_ALLOW_AI_TEST_STUBS=1 (Playwright sets both).
# Do not set either variable on a real production host.
# GUNCE_AI_TEST_MODE=1
# GUNCE_ALLOW_AI_TEST_STUBS=1

# --- Milestone 7: Web Push + reminder scheduler (optional) ---
# Generate VAPID keys: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Dedicated secret for POST /api/internal/reminders/process (min 16 chars)
# REMINDER_SCHEDULER_SECRET=

# --- Milestone 9: local mail preview / test capture (no production provider) ---
# Development only: write HTML preview files under .mail-preview/ (gitignored).
# Open a file directly in a browser (File → Open). Unavailable when NODE_ENV=production.
# GUNCE_MAIL_PREVIEW=1
# GUNCE_MAIL_PREVIEW_DIR=.mail-preview
#
# Automated tests / Playwright only — in-memory + .mail-capture/ JSON files.
# Never enable on a real production host. Playwright sets both automatically.
# GUNCE_MAIL_TEST_CAPTURE=1
# GUNCE_ALLOW_MAIL_TEST_CAPTURE=1
# GUNCE_MAIL_CAPTURE_DIR=.mail-capture
#
# Real SMTP/API email transport is NOT configured in this milestone. Wire a provider
# before external rollout; verification/reset logic already goes through sendMail().
#
# Access: unverified parents can still sign in. Verification is optional for access.
# Password reset invalidates that parent's sessions; emailVerified is unchanged.
