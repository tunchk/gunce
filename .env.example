# Database
DATABASE_URL="postgresql://gunce:gunce@localhost:5432/gunce?schema=public"

# Better Auth — generate a long random secret for local use
# Example: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Milestone 3 / 6: OpenAI (optional) ---
# Without OPENAI_API_KEY, journaling and manual planning still work; voice,
# “Yazımı toparla”, and journal→plan suggestions are marked unavailable.
# OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# OPENAI_SUMMARY_MODEL=gpt-4o-mini
# OPENAI_PLAN_EXTRACT_MODEL=gpt-4o-mini

# Automated tests / Playwright only — enables deterministic AI stubs (never for normal use).
# Under NODE_ENV=production, stubs also require GUNCE_ALLOW_AI_TEST_STUBS=1 (Playwright sets both).
# Do not set either variable on a real production host.
# GUNCE_AI_TEST_MODE=1
# GUNCE_ALLOW_AI_TEST_STUBS=1

# --- Milestone 7: Web Push + reminder scheduler (optional) ---
# Generate VAPID keys: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# Dedicated secret for POST /api/internal/reminders/process (min 16 chars)
# REMINDER_SCHEDULER_SECRET=

# Development note: parent registration does NOT verify email. Better Auth keeps
# emailVerified=false until a future verification flow succeeds. Local sign-in
# works without verification (requireEmailVerification is not enabled).
